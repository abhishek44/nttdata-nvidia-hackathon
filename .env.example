# NVIDIA hosted API or an OpenAI-compatible local NIM endpoint.
NVIDIA_API_KEY=
RECALLZERO_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Leave blank to reuse RECALLZERO_NIM_BASE_URL. Set a separate URL for a local embedding NIM.
RECALLZERO_EMBEDDING_BASE_URL=
RECALLZERO_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
RECALLZERO_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Runtime behavior.
RECALLZERO_DATA_DIR=./data
RECALLZERO_USE_NIM=true
RECALLZERO_LLM_CONCURRENCY=4
RECALLZERO_REQUEST_TIMEOUT_SECONDS=90
RECALLZERO_LOG_LEVEL=INFO

# Agent workflow model can be overridden separately.
RECALLZERO_AGENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
