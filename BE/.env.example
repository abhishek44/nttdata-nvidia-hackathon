# NHTSA
NHTSA_BASE_URL=https://api.nhtsa.gov

# NVIDIA NIM (optional for the baseline; enables LLM extraction + embeddings)
NVIDIA_NIM_LLM_URL=http://localhost:8000/v1
NVIDIA_NIM_LLM_MODEL=your-llm-model
NVIDIA_NIM_EMBED_URL=http://localhost:8001/v1
NVIDIA_NIM_EMBED_MODEL=your-embedding-model
NVIDIA_API_KEY=

# RecallZero
RECALLZERO_ALERT_THRESHOLD=75
RECALLZERO_MIN_CLUSTER_SIZE=4
